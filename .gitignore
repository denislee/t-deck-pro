.vscode/
build

# Dictionary corpora (multi-GB, generated / downloaded, not versioned).
# kaikki.org-dictionary-English.jsonl is the upstream Wiktionary dump;
# eng-pob.tsv is the sorted TSV the firmware reads from /dict/ on SD.
# tools/eng-pob.tsv is a small tracked sample, hence the leading slash.
/kaikki.org-dictionary-English.jsonl
/eng-pob.tsv

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# PlatformIO .ino preprocessing leftovers (the generated .ino.cpp copies).
*.ino.cpp
